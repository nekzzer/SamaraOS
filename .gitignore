# build artifacts
build/
src/**/*.o
doomgeneric-master/doomgeneric/*.o
embed/*.wav.o
src/apps/embed_list.h

# logs / scratch
*.log
build.out
build.err

# python (serve.py byte-code)
__pycache__/
*.pyc

# huge runtime music drops (re-add manually if needed)
music/*.wav

# cross-compiler: built by toolchain/build-cross.sh, not committed
toolchain/cross/
toolchain/src/
toolchain/build-binutils/
toolchain/build-gcc/

disk.img

# quake: built binary + user-supplied game data
www/quake
www/*.pak
www/calc

# toolchain: third-party sources/tarballs fetched+built by the scripts
# (build-cross.sh, userland/build-*.sh); only the scripts are committed
toolchain/*
!toolchain/build-cross.sh

# objcopy'd userland blobs (regenerated by make)
userland/*.bin.o

# quake port: kept out of the repo
quake/
quakegeneric-master/

# clangd index / generated compile db
.cache/
compile_commands.json
